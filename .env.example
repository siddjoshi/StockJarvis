# StockJarvis Configuration Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_DATABASE=stockjarvis
DB_POOL_SIZE=5

# ============================================
# QUANDL API (Data Provider)
# ============================================
QUANDL_API_KEY=your_quandl_api_key_here

# ============================================
# ZERODHA KITE CONNECT (Broker API)
# ============================================
ZERODHA_API_KEY=your_kite_api_key
ZERODHA_API_SECRET=your_kite_api_secret
# Access token is generated after OAuth login, leave empty initially
ZERODHA_ACCESS_TOKEN=
ZERODHA_REDIRECT_URL=http://localhost:8000/broker/callback

# ============================================
# NOTIFICATION SETTINGS
# ============================================
# SendGrid (Email)
NOTIFICATION_SENDGRID_API_KEY=your_sendgrid_api_key
NOTIFICATION_EMAIL_FROM=jarvis@yourdomain.com
NOTIFICATION_EMAIL_TO=your_email@example.com,another@example.com

# Way2SMS (SMS)
NOTIFICATION_WAY2SMS_USERNAME=your_way2sms_username
NOTIFICATION_WAY2SMS_PASSWORD=your_way2sms_password
NOTIFICATION_SMS_TO=9876543210,9123456789

# ============================================
# TRADING PARAMETERS
# ============================================
# Trading mode: 'paper' for paper trading, 'live' for real trades
TRADING_MODE=paper
TRADING_MAX_POSITIONS=5
TRADING_RISK_PER_TRADE=0.02
TRADING_MIN_STRATEGY_ACCURACY=0.65
TRADING_MIN_RISK_REWARD=2.0
TRADING_CAPITAL=100000.0

# ============================================
# REDIS (Task Queue)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=development
APP_DEBUG=True
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/jarvis.log

# API Server
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_API_WORKERS=4

# Scheduled Tasks (Cron format)
# Daily data update: 6 PM on weekdays
APP_DATA_UPDATE_SCHEDULE=0 18 * * 1-5
# Strategy scans: 9:30 AM and 3 PM on weekdays
APP_SCANNER_SCHEDULE=30 9,15 * * 1-5
