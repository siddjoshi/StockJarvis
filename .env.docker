# .env.docker - Docker Environment Variables Template
# Copy this file to .env and update with your actual values

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_ROOT_PASSWORD=your_root_password_change_me
DB_HOST=mysql
DB_PORT=3306
DB_USER=jarvis
DB_PASSWORD=your_secure_password_change_me
DB_DATABASE=stockjarvis

# ============================================================
# REDIS CONFIGURATION
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# ============================================================
# TRADING CONFIGURATION
# ============================================================
TRADING_MODE=paper
TRADING_CAPITAL=100000
TRADING_MAX_POSITIONS=5
TRADING_RISK_PER_TRADE=0.02
TRADING_MIN_STRATEGY_ACCURACY=0.65
TRADING_MIN_RISK_REWARD=2.0

# ============================================================
# DATA PROVIDER API KEYS
# ============================================================
# Quandl API (https://www.quandl.com/)
QUANDL_API_KEY=your_quandl_api_key_here

# ============================================================
# BROKER API KEYS
# ============================================================
# Zerodha Kite Connect (https://kite.trade/)
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_ACCESS_TOKEN=
ZERODHA_REQUEST_TOKEN=
ZERODHA_REDIRECT_URL=http://localhost:5000/jarvispostback

# ============================================================
# NOTIFICATION SERVICES
# ============================================================
# SendGrid Email (https://sendgrid.com/)
NOTIFICATION_SENDGRID_API_KEY=your_sendgrid_api_key
NOTIFICATION_EMAIL_FROM=jarvis@stocktrading.com
NOTIFICATION_EMAIL_TO=admin@example.com,trader@example.com

# Way2SMS (Optional)
NOTIFICATION_WAY2SMS_USERNAME=
NOTIFICATION_WAY2SMS_PASSWORD=
NOTIFICATION_SMS_TO=

# ============================================================
# CELERY FLOWER MONITORING
# ============================================================
FLOWER_USER=admin
FLOWER_PASSWORD=change_this_password

# ============================================================
# DATA COLLECTION SCHEDULES (Cron format)
# ============================================================
# Daily data update at 6:00 PM IST (Mon-Fri)
APP_DATA_UPDATE_SCHEDULE=0 18 * * 1-5

# Strategy scans at 9:30 AM and 3:00 PM IST (Mon-Fri)
APP_SCANNER_SCHEDULE=30 9,15 * * 1-5

# ============================================================
# NOTES
# ============================================================
# - Generate APP_SECRET_KEY: openssl rand -hex 32
# - Time zone is set to Asia/Kolkata (IST) in docker-compose.yml
# - For production: Set TRADING_MODE=live (after thorough testing)
# - For production: Set APP_DEBUG=false and APP_LOG_LEVEL=WARNING
# - Update all passwords and API keys before deployment
